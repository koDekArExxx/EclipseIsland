{
  "name": "eclipse-island",
  "version": "1.0.0",
  "description": "EclipseIsland — a floating island for Windows",
  "author": "EclipseIsland",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.cjs",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "node scripts/build-win.cjs",
    "dist:win:arm64": "node scripts/build-win.cjs --arm64",
    "build:media": "node scripts/build-media.cjs",
    "build:preview": "node scripts/build-preview.cjs",
    "build:online": "node scripts/build-online.cjs",
    "fetch:encoder": "node scripts/fetch-encoder.cjs"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "jsdom": "31.0.1"
  },
  "build": {
    "appId": "app.eclipseisland.desktop",
    "productName": "EclipseIsland",
    "asar": true,
    "files": [
      "electron/**/*",
      "spotify-bridge/**/*",
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/media-bridge.ps1",
      "electron/native/**/*",
      "spotify-bridge/**/*",
      "electron/encoder/**/*",
      "electron/transfers.ps1",
      "electron/process-list.ps1",
      "electron/screenshot-frame.ps1",
      "electron/transfers-restore.ps1",
      "electron/transfers-visibility.cs",
      "src/eclipse.ico"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "EclipseIsland-Setup-${version}-${arch}.exe",
      "icon": "src/eclipse.ico",
      "signExecutable": false
    },
    "compression": "normal",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EclipseIsland",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "displayLanguageSelector": false,
      "include": "build/installer.nsh",
      "artifactName": "EclipseIsland-Setup-${version}-${arch}.exe",
      "differentialPackage": false,
      "packElevateHelper": false
    },
    "electronLanguages": [
      "en-US",
      "ru"
    ]
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "nativeMediaVersion": "0.7.0"
}
